# IDrive e2 credentials (referenced by plugin config via *Env keys)
IDRIVE_E2_ACCESS_KEY=
IDRIVE_E2_SECRET_KEY=

# IDrive e2 endpoint (your region's white-label or backend endpoint)
# Examples:
#   https://s3.us-east-1.idrivee2.com
#   https://m1w7.tyo03.idrivee2-99.com
IDRIVE_E2_ENDPOINT=https://s3.us-east-1.idrivee2.com
IDRIVE_E2_REGION=us-east-1

# Buckets
TCM_SOURCE_BUCKET=tcm-study
TCM_MCQ_BUCKET=tcm-mcqs

# NotebookLM CLI binary (https://pypi.org/project/notebooklm-mcp-cli/)
TCM_NLM_BIN=/Users/yourname/.local/bin/nlm

# Local state directory for SQLite index, jobs, notebook map
TCM_DATA_DIR=/Users/yourname/.tcm
