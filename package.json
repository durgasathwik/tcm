{
  "name": "tcm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenClaw plugin suite: IDrive e2 index + NotebookLM bridge + MCQ generation pipeline",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "clean": "pnpm -r exec rm -rf dist && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@types/node": "^22.5.0"
  },
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "koffi",
      "openclaw",
      "protobufjs",
      "tree-sitter-bash"
    ]
  }
}
