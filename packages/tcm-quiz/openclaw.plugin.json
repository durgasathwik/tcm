{
  "id": "tcm-quiz",
  "name": "TCM Quiz Pipeline",
  "description": "Generates MCQ CSVs from study files. Resolves source as '<bucket>/<keyOrPrefix>' across the subject buckets indexed by tcm-idrive, drives NotebookLM (reusing notebooks per topic), writes CSV to a separate output bucket. Exposes openclaw tcm quiz ... CLI and an mcq_status tool.",
  "version": "0.1.0",
  "contracts": {
    "tools": ["mcq_status"]
  },
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "outputBucket": {
        "type": "string",
        "description": "S3 bucket where generated CSVs land. Should be separate from subject buckets.",
        "default": "tcm-mcqs"
      },
      "endpoint": {
        "type": "string",
        "description": "IDrive e2 endpoint URL.",
        "default": "https://s3.ap-northeast-1.idrivee2.com"
      },
      "region": {
        "type": "string",
        "default": "ap-northeast-1"
      },
      "accessKeyEnv": {
        "type": "string",
        "default": "IDRIVE_E2_ACCESS_KEY"
      },
      "secretKeyEnv": {
        "type": "string",
        "default": "IDRIVE_E2_SECRET_KEY"
      },
      "subjectBuckets": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Allowed subject buckets — quiz generate rejects any bucket not in this list. Empty = allow any.",
        "default": []
      },
      "dataDir": {
        "type": "string",
        "default": "~/.tcm"
      },
      "nlmBin": {
        "type": "string",
        "default": "~/.local/bin/nlm"
      },
      "maxFilesPerJob": {
        "type": "integer",
        "default": 5
      },
      "presignTtlSeconds": {
        "type": "integer",
        "default": 86400
      },
      "csvSchema": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["question", "A", "B", "C", "D", "correct", "explanation", "source_key"]
      }
    }
  }
}
